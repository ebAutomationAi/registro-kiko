# ============================================
# REGISTRO-KIKO .gitignore
# ============================================

# Variables de entorno (NUNCA subir)
.env

# Dependencias de Node.js
node_modules/
npm-debug.log*

# Datos personales (descomenta si NO quieres backup del JSON en git)
data/candidaturas.json
data/*.backup.*
data/candidaturas_reales.json

# Capturas de pantalla (pueden contener datos personales)
Captura de pantalla*.png

# Docker
*.pid

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Graphify
graphify-out/
