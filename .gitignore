# ============================================
# REGISTRO-KIKO .gitignore
# ============================================

# Variables de entorno (NUNCA subir)
.env

# Dependencias de Node.js
node_modules/
npm-debug.log*

# Datos personales — todo lo que haya en data/ (candidaturas, backups, .bak,
# exports manuales, etc.). Nunca debe llegar a un repo publico.
data/

# Capturas de pantalla (pueden contener datos personales)
Captura de pantalla*.png

# Docker
*.pid

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Graphify
graphify-out/
