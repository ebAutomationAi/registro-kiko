# ============================================
# CONFIGURACION REGISTRO-KIKO
# ============================================
# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a Git (ya esta en .gitignore).
# ============================================

# --------------------------------------------
# OBLIGATORIOS - El servidor NO arrancara sin estos
# --------------------------------------------

# JWT: clave secreta para firmar tokens (minimo 32 caracteres)
# Genera con: openssl rand -base64 48
JWT_SECRET=

# Password para acceder al panel web (minimo 6 caracteres)
# Se almacena hasheada con bcrypt. No se guarda en texto plano.
ADMIN_PASSWORD=

# API key de Groq (gratuita en https://console.groq.com/keys)
GROQ_API_KEY=

# --------------------------------------------
# OPCIONALES
# --------------------------------------------

# Entorno: production | development
NODE_ENV=production

# Origenes permitidos para CORS (separados por coma)
# En produccion, pon tu dominio exacto: https://registro-kiko.duckdns.org
# Dejar vacio permite cualquier origen (solo para desarrollo local)
ALLOWED_ORIGINS=

# Puerto interno del contenedor (no cambiar si usas docker-compose)
PORT=3000

# --------------------------------------------
# MONITOR DE EMAIL (opcional — sin estos dos, el monitor arranca desactivado)
# --------------------------------------------

# Cuenta Gmail a monitorizar via IMAP
GMAIL_USER=

# App Password de Gmail (NO la contrasena normal de la cuenta).
# Requiere verificacion en 2 pasos activada. Generar en:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Intervalo entre escaneos automaticos del buzon, en milisegundos.
# Por defecto 900000 (15 min) si se deja vacio.
EMAIL_POLL_MS=900000
